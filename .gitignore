# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Data / output artefacts (keep large instrument data out of the repo)
*.wdf
*.spc
*.png
*.pdf
*.csv
*.xlsx
!docs/**/*.png

# Testing
.pytest_cache/
.coverage

# PCA Studio is its own standalone project/repo, kept inside this folder for
# convenience only — never part of the BioRaman repo
pca-studio/

# Local working backups / generated presentation artefacts (not part of the release)
bioraman_backup_*.py
BioRaman_Live_Demo.pptx
BioRaman_Interactive.html
BioRaman_Tool_Comparison.pptx
BioRaman_tool_comparison.html

# Keep the bundled example dataset (small enough to ship; see example/README.md)
!example/
!example/*.pdf
!example/*.png
example/.DS_Store

# Large / licence-restricted raw data — not redistributed in the repo
example/*.wdf
example/*.wip
pcrs_library/
raman-augment/
FlyHash_Connectome_Study/

# Local working copies of the main app (canonical file is bioraman.py)
bioraman16*.py
bioraman_pupae.py

# Generated documents / artefacts (not part of the release)
*.docx
*.pptx
example/paracetamol.wdf
