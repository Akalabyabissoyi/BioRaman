.ipynb_checkpoints/

# Data / output artefacts (keep large instrument data out of the repo)
*.wdf
*.spc
*.png
*.pdf
*.csv
*.xlsx
!docs/**/*.png

# Testing
.pytest_cache/
.coverage

# PCA Studio is its own standalone project/repo, kept inside this folder for
