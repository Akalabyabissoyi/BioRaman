# Keep the bundled example dataset (small enough to ship; see example/README.md)
!example/
!example/*.pdf
!example/*.png
example/.DS_Store

# Large / licence-restricted raw data — not redistributed in the repo
example/*.wdf
example/*.wip
pcrs_library/
raman-augment/
FlyHash_Connectome_Study/

# Personal-only library overlay (private; extends the public set locally)
ramanbiolib_personal.py
pcrs_library_personal/

# Local working copies of the main app (canonical file is bioraman.py)
bioraman16*.py
bioraman_pupae.py
bioramanv*.py
bioraman[0-9]*.py
bioraman [0-9]*.py

# Archived old app copies (kept locally for reference, not part of the release)
archive/

